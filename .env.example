# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=investment_forecaster
DB_USER=postgres
DB_PASSWORD=your-password-here

# Portfolio database (managed by investment-portfolio-manager, read-only from here)
PORTFOLIO_DB_NAME=investment_portfolio

# Anthropic API
ANTHROPIC_API_KEY=your-api-key-here

# IBKR Client Portal Gateway (primary market data source)
# Leave as default if running on the same machine as TWS / Client Portal Gateway.
IBKR_GATEWAY_URL=https://localhost:5000

# SEC EDGAR (earnings/primary_source agents' financials + filings + insider transactions)
# Required by SEC's fair-access policy: a descriptive User-Agent identifying the requester.
# Requests without a real contact email risk throttling/blocking.
SEC_EDGAR_USER_AGENT=investment-forecaster/1.0 (your-email@example.com)
